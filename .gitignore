# data & model artifacts — NEVER commit (PHI / large binaries)
# NOTE: leading slash = repo-root only, so src/data/ source is NOT ignored
/data/
/checkpoints/
/benchmark/results/
*.parquet
*.csv
*.pt
*.bin
*.ckpt
*.safetensors
vocab.json

# python
__pycache__/
*.pyc
.venv/
uv.lock
# clif-validate ships a committed, pinned lock for reproducible offline site installs.
!clif-validate/uv.lock
.ipynb_checkpoints/

# experiment tracking
wandb/
runs/
*.log

# secrets — real filled-in config (template is tracked); never commit a live wandb key
clif_config.json
config/secrets.json
config/credentials.json

# os / editor
.DS_Store
.idea/
.vscode/

# local tooling / binaries (per-machine, do not commit)
.agents/
bin/
docusaurus-dev.log
