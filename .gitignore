# data & model artifacts — NEVER commit (PHI / large binaries)
# NOTE: leading slash = repo-root only, so src/data/ source is NOT ignored
/data/
/output/
/checkpoints/
/benchmark/results/
*.parquet
*.csv
# ...except the physician-designed bin definitions the tokenizer reads (configs/data.yaml segment_source)
!external/clifatron/tokenETL/config/critical_illness_tokenization_final_with_intervals.csv
# ...and the public CLIF v2.1.1 mCIDE permissible-value snapshot (spec files, no patient data)
!configs/clif_mcide_2.1.1/**/*.csv
*.pt
*.bin
*.ckpt
*.safetensors
vocab.json

# python
__pycache__/
*.pyc
.venv/
uv.lock
# Commit the root lock for reproducible CI + a recreatable research environment (U16), and
# clif-validate's for reproducible offline site installs (U11). Anchor the root exception to
# the repo root (!/uv.lock) so it does not accidentally un-ignore nested/generated lockfiles.
!/uv.lock
!clif-validate/uv.lock
.ipynb_checkpoints/

# experiment tracking
wandb/
runs/
*.log

# secrets — real filled-in config (template is tracked); never commit a live wandb key
clif_config.json
config/secrets.json
config/credentials.json

# os / editor
.DS_Store
.idea/
.vscode/

# local tooling / binaries (per-machine, do not commit)
.agents/
# vendored third-party agent skills + session-local agent state (install globally instead)
/agent/
/.claude/skills/
/.claude/scheduled_tasks.lock
/skills-lock.json
bin/
docusaurus-dev.log
